# AventasPay Frontend Environment Configuration Example

# Public base URL used for checkout redirect links, QR codes, and iframe embed snippets.
# Fallback if omitted: window.location.origin
VITE_PUBLIC_BASE_URL=http://localhost:4000

# Security gate for database wipe action in Settings -> Danger Zone.
# Must be set to 'true' to allow clearing the database.
VITE_ALLOW_DB_RESET=false
