# AventasPay Unified Server & Gateway Environment Configuration

# Port for unified server (API, IMAP worker, static frontend delivery)
PORT=4000

# Public base URL used for checkout redirects, pay links, and embed widgets
PUBLIC_BASE_URL=http://localhost:4000
VITE_PUBLIC_BASE_URL=http://localhost:4000

# Security gate for database wipe action in Settings -> Danger Zone
ALLOW_DB_RESET=false
VITE_ALLOW_DB_RESET=false

# Demo mode: When true, demo seeding scripts can inject mock records for testing/screenshots
# Normal production runs must leave this false or unset.
DEMO_MODE=false

# Primary Slice Bank IMAP Credentials (can also be configured via Settings UI)
IMAP_USER=
IMAP_PASSWORD=
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_POLL_INTERVAL=5
UPI_ID=shadow@slc

# Optional Discord Bot / Webhook Notification
DISCORD_WEBHOOK_URL=
