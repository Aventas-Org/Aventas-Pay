# ---------------------------------------------------------------------------
# Aventas Stage 1 — bot-side checkout configuration (template)
#
# Copy the variables you need into the bot's existing .env. NEVER commit real
# values; this file contains placeholders only. The website-side (Cloudflare
# Worker) secrets are set with `wrangler secret put`, not with an env file —
# see docs/DEPLOYMENT_CHECKLIST.md.
# ---------------------------------------------------------------------------

# Master feature flag. false/empty keeps the existing manual UPI flow only.
# Raise CheckoutDisabled at startup if true and the variables below are missing.
AVENTAS_CHECKOUT_ENABLED=false

# Public base URL of the Aventas website (used to build the checkout link the
# customer opens). No trailing slash needed.
AVENTAS_WEBSITE_BASE_URL=https://aventasgaming.com

# Origin the client sends API requests to; the client appends
# /api/payments/checkout-sessions... paths itself.
AVENTAS_PAYMENT_API_URL=https://aventasgaming.com

# Dedicated server-to-server secret (min 16 chars, use 32+ random bytes).
# Shared with the website Worker PAYMENT_API_SECRET. NEVER log it; the
# client hides it from repr/str and masks it in logs.
AVENTAS_PAYMENT_API_SECRET=replace-with-generated-secret

# Optional tuning (defaults shown).
# AVENTAS_CHECKOUT_CONNECT_TIMEOUT=5
# AVENTAS_CHECKOUT_TOTAL_TIMEOUT=10
# AVENTAS_CHECKOUT_MAX_RETRIES=2
# AVENTAS_CHECKOUT_TTL_SECONDS=1800
